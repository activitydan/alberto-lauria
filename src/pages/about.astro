---
import ProfilePage from '../components/ProfilePage.astro'
---

<ProfilePage>
  <Fragment slot="head">
    <title>About — Spazio Desk</title>
    <meta
      name="description"
      content="Alberto Lauria, Graphic Designer e Direttore Creativo classe 2006. Fondatore di Spazio Desk, studio collettivo creativo con sede a Ragusa, Sicilia."
    />
    <link rel="canonical" href="https://spaziodesk.com/about" />
    <meta name="author" content="Alberto Lauria" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="keywords" content="Spazio Desk, Alberto Lauria, About, Studio Collettivo Creativo, Ragusa, Sicilia, Graphic Design" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Spazio Desk" />
    <meta property="og:title" content="About — Spazio Desk" />
    <meta
      property="og:description"
      content="Alberto Lauria, Graphic Designer e Direttore Creativo. Fondatore di Spazio Desk, studio collettivo creativo a Ragusa, Sicilia."
    />
    <meta property="og:url" content="https://spaziodesk.com/about" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:image" content="https://albertolauria.com/icons/android-chrome-512x512.png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Alberto Lauria — Fondatore di Spazio Desk" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="About — Spazio Desk" />
    <meta
      name="twitter:description"
      content="Alberto Lauria, Graphic Designer e Direttore Creativo. Fondatore di Spazio Desk, studio collettivo creativo a Ragusa, Sicilia."
    />
    <meta name="twitter:image" content="https://albertolauria.com/icons/android-chrome-512x512.png" />
    <meta name="twitter:image:alt" content="Alberto Lauria — Fondatore di Spazio Desk" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': 'https://spaziodesk.com/#website',
          name: 'Spazio Desk',
          url: 'https://spaziodesk.com',
          description: 'Studio Collettivo Creativo fondato da Alberto Lauria a Ragusa, Sicilia.',
        },
        {
          '@type': 'AboutPage',
          '@id': 'https://spaziodesk.com/about#webpage',
          name: 'About — Spazio Desk',
          url: 'https://spaziodesk.com/about',
          isPartOf: { '@id': 'https://spaziodesk.com/#website' },
          about: { '@id': 'https://spaziodesk.com/#organization' },
          breadcrumb: {
            '@type': 'BreadcrumbList',
            itemListElement: [
              {
                '@type': 'ListItem',
                position: 1,
                name: 'Spazio Desk',
                item: 'https://spaziodesk.com',
              },
              {
                '@type': 'ListItem',
                position: 2,
                name: 'About',
                item: 'https://spaziodesk.com/about',
              },
            ],
          },
        },
        {
          '@type': 'Organization',
          '@id': 'https://spaziodesk.com/#organization',
          name: 'Spazio Desk',
          url: 'https://spaziodesk.com',
          description: 'Studio Collettivo Creativo con sede a Ragusa, Sicilia.',
          foundingLocation: {
            '@type': 'Place',
            name: 'Ragusa, Sicily, Italy',
          },
          address: {
            '@type': 'PostalAddress',
            streetAddress: 'Via Ruggero Settimo, 16',
            addressLocality: 'Ragusa',
            addressRegion: 'Sicily',
            addressCountry: 'IT',
          },
          founder: {
            '@type': 'Person',
            '@id': 'https://albertolauria.com/#person',
            name: 'Alberto Lauria',
            url: 'https://albertolauria.com',
            jobTitle: 'Graphic Designer and Creative Director',
            sameAs: ['https://instagram.com/2albbb'],
          },
        },
      ],
    })} />
  </Fragment>
</ProfilePage>
